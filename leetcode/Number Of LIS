class Solution {
public:
    int findNumberOfLIS(vector<int>& nums) {
         int n=nums.size();
         vector<int>dp(n,1);
          vector<int>count(n,1);
         int maxi=0;
         for(int i=0;i<n;i++){
          for(int prev=0;prev<i;prev++){
            if(nums[prev]<nums[i] && 1+dp[prev]>dp[i]){
                dp[i]=1+dp[prev];
                //inherit the count
                count[i]=count[prev];
            }
            else if(nums[i]>nums[prev] && 1+dp[prev]==dp[i]){
                count[i]+=count[prev];// increase the cnt
            }
          }
          maxi=max(maxi,dp[i]);
          
         }
         int cnt=0;
         for(int i=0;i<n;i++){
            if(dp[i]==maxi) cnt+= count[i];
         }
         return cnt;
    }
};
