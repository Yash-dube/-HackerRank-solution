class Solution {
    private:
        bool CheckPalindrome(int i,int j,string &s){
            while(i<j){
               if(s[i]!=s[j]) { return false;}
                i++;
                j--;
            }
            return true;
        }
public: 
    int minCut(string s) {
       int n=s.size();
       vector<int>dp(n+1,0);
       dp[n]==0;  // base case
       for(int i=n-1;i>=0;i--){
         int ans=INT_MAX;
         string temp="";
         for(int j=i;j<n;j++){

            if(CheckPalindrome(i,j,s)){

            int partition = 1+dp[j+1];
            ans= min(ans,partition);
            }
         }
         dp[i]=ans;
       }
       return dp[0]-1; 
    }
};
